# Existing environment variables
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- AI keys -----------------------------------------------------------------
# This file is tracked by git. NEVER put a working key here — only placeholders.
# A real key committed here is a leaked key: rotate it at the provider's
# dashboard, and removing it in a later commit does not unpublish it.

# Gemini — the LLM behind the chat widget, the AI agent, the AI summary, and the
# Rx copilot's note structuring. Must be named GEMINI_API_KEY: that is what
# lib/ai/gemini-provider.ts reads. (An older GOOGLE_GEMINI_API_KEY name here did
# nothing.)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Groq — speech-to-text ONLY (Whisper) for the ambient Rx copilot. This is not an
# LLM key and is deliberately kept separate from the Gemini one above.
GROQ_API_KEY=your_groq_api_key

# Resend (for email)
RESEND_API_KEY=your_resend_api_key

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# Webhook handshake + signature verification (server-only, required in prod:
# without META_APP_SECRET the webhook rejects signed POSTs as 401).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any_secret_string_you_choose
META_APP_SECRET=your_meta_app_secret

# Optional Graph overrides (defaults: v23.0, inbound rate 10/min).
META_GRAPH_VERSION=v23.0
WHATSAPP_RATE_LIMIT_PER_MINUTE=10

# Browser-safe Meta app ids — only needed for the Embedded Signup popup.
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
NEXT_PUBLIC_META_CONFIG_ID=your_fb_login_business_config_id

# Bearer auth for /api/cron/appointment-reminders (Vercel Cron sends it too).
# Random >=16 chars. The business access token itself is NOT an env var — it
# lives in the clinic_whatsapp_secrets table (paste it in AI Settings or the
# manual-connect action).
CRON_SECRET=your_random_cron_secret
