# MedBook AI — environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# Generate a local Supabase project with `supabase start`, or use a hosted
# project at https://supabase.com/dashboard.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute URL of this app. Used as the redirect target for verification and
# password-reset emails, so it must be reachable from the email client.
# For local development against `supabase start`, use the URL that Supabase
# Auth's "Site URL" is set to (usually http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base domain for subdomain-based public website routing (production only).
# When set, requests to `clinic-slug.BASE_DOMAIN` are rewritten to /site/[slug].
# Leave unset for local dev (use /site/[slug] directly).
# NEXT_PUBLIC_BASE_DOMAIN=app.example.com

# ---------------------------------------------------------------------------
# Supabase Auth settings you must configure in the dashboard (no code change):
#   - Authentication > Sign In / Up: enable "Confirm email" to require email
#     verification (the /verify flow is built for this).
#   - Authentication > URL Configuration > Site URL: same as NEXT_PUBLIC_SITE_URL.
#   - Authentication > URL Configuration > Redirect URLs: add
#     http://localhost:3000/auth/callback (and your deployed URL).
#   - Password recovery will not send emails on `supabase start` until SMTP is
#     configured; hosted projects include the default Supabase email service.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Gemini (AI receptionist, Phase 5). Server-only — never exposed to the
# browser. The API key lives only in `.env.local`; leave these blank here.
# GEMINI_MODEL defaults to "gemini-3.5-flash-lite" when unset.
# GEMINI_FALLBACK_MODEL is tried once if the primary hits daily quota limits.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional rate-limit tuning for the internal AI chat endpoint.
# AI_CHAT_RATE_LIMIT=30
# AI_CHAT_IP_RATE_LIMIT=60

# ---------------------------------------------------------------------------
# AI Patient Summary (Phase 5). OFF BY DEFAULT — read this before enabling.
#
# Setting PATIENT_AI_SUMMARY_ENABLED=true sends patient clinical data to
# Google Gemini: recorded diagnoses, prescribed medicines, doctor's notes,
# findings and vitals. That is a materially higher sensitivity class than the
# booking data the WhatsApp receptionist sends, and enabling it is a privacy
# and compliance decision for the clinic to make, not a deployment detail.
#
# What is NOT sent (see lib/ai/patient-summary.ts): name, phone, email,
# WhatsApp number, UHID/patient_code, city, branch, or the treating doctors'
# names. The payload is de-identified before it leaves the server.
#
# With this unset or set to anything other than the literal "true", no model
# call is ever made. The summary card still renders any previously cached
# summary from patients.ai_summary, and the refresh control is hidden.
#
# Generation is manual only — a staff member clicking refresh. Nothing is
# generated on page load. PATIENT_AI_SUMMARY_RATE_LIMIT caps generations per
# user per HOUR (default 20); cached reads are not counted against it.
# ---------------------------------------------------------------------------
# PATIENT_AI_SUMMARY_ENABLED=true
# PATIENT_AI_SUMMARY_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Public widget rate limits (Phase 6). The widget chat endpoint is
# unauthenticated and faces the public internet — tighter limits than the
# internal test chat.
# WIDGET_CHAT_IP_RATE_LIMIT: per-IP, per 60s window (default 20).
# WIDGET_CHAT_SLUG_RATE_LIMIT: per-clinic-slug, per 60s window (default 60).
# ---------------------------------------------------------------------------
# WIDGET_CHAT_IP_RATE_LIMIT=20
# WIDGET_CHAT_SLUG_RATE_LIMIT=60

# ---------------------------------------------------------------------------
# Supabase service-role key — used ONLY by the public widget API routes
# (server-side, never exposed to the browser). Required for unauthenticated
# access to clinic data with manual scoping (bypasses RLS intentionally).
# Find it in: Supabase Dashboard > Settings > API > service_role key.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend (transactional emails, Phase 8). Server-only — never exposed to the
# browser. Sign up at https://resend.com to get an API key.
# RESEND_FROM_EMAIL must be from a verified domain in Resend, or use the
# default onboarding@resend.dev for testing.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=MedBook AI <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Phase 12). Server-only except the two NEXT_PUBLIC
# launch ids (public by design — Meta's JS SDK needs them in the browser).
# The access token exchanged during Embedded Signup is stored server-side only
# in a service-role-only column and is never sent to any client.
#
# Setup (Meta for Developers):
#   1. Meta app configured as a Tech Provider / business type with Advanced
#      access to whatsapp_business_management + whatsapp_business_messaging.
#   2. Facebook Login for Business configuration created from the "WhatsApp
#      Embedded Signup Configuration With 60 Expiration Token" template —
#      its configuration id goes in NEXT_PUBLIC_META_CONFIG_ID.
#   3. This deployment's domain added to Allowed domains / Valid OAuth
#      redirect URIs on that configuration.
# Without these values the Connect button explains that signup isn't enabled
# yet; everything else in AI Settings keeps working.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
META_APP_SECRET=
# META_GRAPH_VERSION defaults to v23.0 when unset.
# META_GRAPH_VERSION=v23.0

# ---------------------------------------------------------------------------
# WhatsApp webhook + reminders (Phase 13). Server-only.
#
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: any random string you invent. Put the SAME
#   value in the Meta App dashboard when subscribing the
#   whatsapp_business_account webhook to this endpoint:
#     https://<your-domain>/api/whatsapp/webhook
# CRON_SECRET: shared secret protecting POST /api/cron/appointment-reminders.
#   Send it as `Authorization: Bearer <CRON_SECRET>` (or `x-cron-secret`) from
#   your scheduler. Reminders are idempotent via appointments.reminder_sent_at;
#   they only deliver inside Meta's 24h customer-service window until message
#   templates are approved (future work).
# WHATSAPP_RATE_LIMIT_PER_MINUTE: per-sender inbound processing cap per 60s
#   window (default 10).
# ---------------------------------------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
# WHATSAPP_RATE_LIMIT_PER_MINUTE=10
